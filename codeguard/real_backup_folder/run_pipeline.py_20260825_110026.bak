import time
import sys
import os

# 確保當前目錄能被正確搜尋
sys.path.append(os.path.dirname(os.path.abspath(__file__)))

try:
    from core_engine import GenesisCoreEngine
except ImportError as e:
    print(f"-> [!] 導入核心引擎失敗: {e}")
    GenesisCoreEngine = None

class MasterEcosystemPipeline:
    def __init__(self):
        print("-> 🌐 [Master Pipeline] 正在初始化全面升級的實戰生態系...")
        self.engine = GenesisCoreEngine() if GenesisCoreEngine else None

    def execute_all(self):
        print("-> 🚀 [Execution] 開始執行全系統端到端自動化任務...")
        start_time = time.time()

        if self.engine:
            try:
                # 透過核心引擎統一調度所有模組 (心跳、資源、日誌、備份)
                self.engine.run_full_pipeline()
                print("-> [✨] 所有實戰模組已完美協同運作完畢！")
            except Exception as e:
                print(f"-> [!] 執行管線時發生例外錯誤: {e}")
        else:
            print("-> [!] 錯誤：找不到 GenesisCoreEngine，無法啟動管線。")

        duration = time.time() - start_time
        print(f"-> [🎉] 總管線任務執行完畢，總耗時: {duration:.4f} 秒\n")

if __name__ == "__main__":
    pipeline = MasterEcosystemPipeline()
    pipeline.execute_all()

