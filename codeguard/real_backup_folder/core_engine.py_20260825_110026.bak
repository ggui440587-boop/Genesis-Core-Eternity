import time
from exception_handler_module import ExceptionHandlerModule
from heartbeat_scheduler_module import HeartbeatModule
from resource_monitor_module import ResourceMonitorModule
from log_analyzer_module import LogAnalyzerModule
from backup_cleaner_module import BackupCleanerModule
from config_loader_module import ConfigLoaderModule

class GenesisCoreEngine:
    def __init__(self):
        print("-> 🌟 [Genesis Engine] 正在初始化全面升級的多語言自動化生態系...")
        self.config_loader = ConfigLoaderModule()
        self.config = self.config_loader.load_config()

        # 根據設定檔初始化模組
        self.heartbeat = HeartbeatModule()
        self.monitor = ResourceMonitorModule()
        self.analyzer = LogAnalyzerModule()
        self.backup = BackupCleanerModule()

    @ExceptionHandlerModule.safe_execute(task_name="Advanced_Pipeline_Execution")
    def run_full_pipeline(self):
        print(f"-> 🚀 [Pipeline] 開始執行模式 [{self.config.get('mode', 'production')}] 的自動化管線...")

        # 1. 發送心跳
        self.heartbeat.send_heartbeat()

        # 2. 檢查資源
        self.monitor.check_disk_space()

        # 3. 分析日誌
        self.analyzer.analyze_logs()

        # 4. 執行備份
        self.backup.create_backup()

        print("   [✓] 所有升級版自動化管線任務已圓滿完成！")

if __name__ == "__main__":
    engine = GenesisCoreEngine()
    engine.run_full_pipeline()

